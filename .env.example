VITE_API_BASE_URL=http://localhost:5000/api

# Public website, for the "view on the website" link on published posts.
# Defaults to https://grc.lk when unset.
VITE_PUBLIC_SITE_URL=https://grc.lk

# Optional. A Google API key with the Drive API enabled (restrict it to this site's
# domain). Gem videos then stream from the Drive API rather than Drive's public
# download address, which is less prone to quota errors. Works without it.
VITE_GOOGLE_API_KEY=
